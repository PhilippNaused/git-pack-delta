# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

# PowerShell scripts
[*.{ps1,psm1,psd1}]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true

# xml files
[*.{xml,config}]
indent_size = 2
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = false

# Json file
[*.json]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = false

# Rust source code
[*.rs]
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Git source code (https://github.com/git/git/blob/master/.editorconfig)
[git-pack-delta/tests/data/diff-delta.c]
charset = utf-8
insert_final_newline = true
indent_style = tab
tab_width = 4