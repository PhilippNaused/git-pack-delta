{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "words": [],
  "flagWords": [],
  "ignorePaths": [
    ".config/cspell.json",
    ".config/dicts/**",
    ".git*",
    "*.svg",
    "*/tests/data/**",
    "Notes.md"
  ],
  "dictionaries": [
    "project-words",
    "rust-crates",
    "rust",
    "SIMD"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./dicts/project-words.txt",
      "addWords": true
    },
    {
      "name": "SIMD",
      "path": "./dicts/SIMD.txt",
      "addWords": true
    }
  ]
}